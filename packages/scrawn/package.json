{
  "name": "@scrawn/core",
  "version": "0.0.15",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"try { require('fs').rmSync('dist', {recursive: true, force: true}) } catch(e) {} try { require('fs').rmSync('tsconfig.tsbuildinfo', {force: true}) } catch(e) {}\"",
    "gen": "cd proto && bunx buf generate && node ../scripts/cleanup-grpc-js.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "proto:pull": "git submodule update --remote --merge proto",
    "proto:push": "cd proto && git add . && git commit -s -m \"$1\" && git push && cd .."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@grpc/grpc-js": "^1.13.1",
    "chalk": "^5.6.2",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "vitest": "1.6.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "1.6.1",
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.11.8",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
